[Unit]
Description=cliamp-server - OmaRadio streaming server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omaradio
Group=omaradio
# Leading '-' makes this optional: service still starts (with admin auth
# disabled) if the secret hasn't been provisioned yet. See config.toml's
# [admin] comment and `make cliamp-service-install`.
EnvironmentFile=-/opt/omaradio/secrets/cliamp.env
ExecStart=/usr/local/bin/cliamp-server --config /opt/omaradio/config.toml --password ${ADMIN_PASSWORD}
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/omaradio
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
