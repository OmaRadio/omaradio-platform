[Unit]
Description=Run the Vera auto-generator 15min ahead of each block build that can place her

[Timer]
# 23:45 / 05:45 / 11:45 / 17:45 UTC -- 15min before each of the
# 00:00/06:00/12:00/18:00 UTC block builds (see
# omaradio-playlist-builder@.timer), NOT Vera's own 00/08/16/18 slot
# hours. plan_block() evaluates pick_latest() once, at block-build time --
# a fresh segment for her 08:00 appearance (offset 7200s into the 06:00
# block) must exist by 06:00, not 08:00. Four entries now, one per block:
# since STATION_PERIODIC_SEGMENTS added hour 18 (2026-09-05, once
# dj-nikon's hand-off pool existed for it), every block gets exactly one
# Vera occurrence -- there's no longer a block to skip.
OnCalendar=*-*-* 23,05,11,17:45:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
