# Copy to .env (repo root) and fill in. .env is gitignored -- never commit
# a real key. See ../../CLAUDE.md and README.md in this directory for the
# rest of the pipeline's setup.

ANTHROPIC_API_KEY=

# Optional overrides -- all have sane defaults, see `--help` on either script.
# ANTHROPIC_MODEL=claude-sonnet-5
# KOKORO_MODEL_PATH=/path/to/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=/path/to/voices-v1.0.bin
# LOCAL_LIBRARY=/path/to/media_library/library
